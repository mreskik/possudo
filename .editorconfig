root = true

[*]
charset = utf-8
end_of_line = lf
indent_size = 4
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

# Konfigurasi Khusus PHP (Mengikuti PSR-12 / PER Style Guide)
[*.php]
indent_style = space
indent_size = 4
max_line_length = 120

[*.{js,ts,vue,css,json,html}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.{yml,yaml}]
indent_size = 2

[{compose,docker-compose}.{yml,yaml}]
indent_size = 4